<?xml version="1.0" encoding="utf-8"?>
<!--
    Les trois seuls dossiers que le FileProvider expose : `files/photos/`, là où
    StockagePhotos range les images, `cache/documents/`, où StockageDocuments
    écrit les PDF à envoyer, et `cache/scans/`, où StockageScans reçoit un devis
    photographié. Rien d'autre du stockage de l'application n'est
    atteignable par un URI, en particulier pas la base de données.
-->
<paths>
    <files-path
        name="photos"
        path="photos/" />

    <!--
        Les devis en PDF, produits pour être envoyés. Dans le cache et non dans
        `files/` : un PDF est dérivé du devis, se reconstruit à l'identique, et n'a
        donc rien à faire dans l'archive de sauvegarde.
    -->
    <cache-path
        name="documents"
        path="documents/" />

    <!--
        Les pages d'un devis fournisseur photographiées pour être lues, puis
        effacées aussitôt : elles portent des prix nets, qui n'ont rien à faire
        dans une sauvegarde.
    -->
    <cache-path
        name="scans"
        path="scans/" />
</paths>
