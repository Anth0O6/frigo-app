<?xml version="1.0" encoding="utf-8"?>
<!--
    L'icône adaptative, la seule que voient les appareils couverts par `minSdk 26`.

    Le calque avant est l'**emblème seul** — la jauge, le flocon, la flamme — et non
    le logo entier : le lanceur masque la toile de 108 dp pour n'en garder qu'un
    disque de 72 dp, où le mot « FRIGOPRO » et la rangée d'outils ne tiennent pas.
    Les y laisser aurait donné une icône tronquée différemment sur chaque téléphone.
    Le logo complet reste dans `design/`, et se refabrique par
    `design/genere-icones.py`.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
