<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        La seule permission de l'application, et elle ne sert qu'au calcul
        d'itinéraire (voir `ItineraireRelais`) : aucune API Android ne calcule
        une route hors ligne. L'application ne contacte qu'un seul hôte, le
        relais du projet, et n'y envoie que deux adresses — aucune clé ne part
        d'ici, elle vit dans le relais. Tout le reste fonctionne sans réseau, et
        la saisie à la main des kilomètres reste le chemin de secours — un
        technicien au fond d'une chambre froide n'a pas de signal.

        `INTERNET` est une permission dite normale : elle ne se demande pas à
        l'utilisateur, elle se déclare. Ni caméra, ni stockage, ni position : les
        photos passent par une application tierce, et le point de départ se
        saisit plutôt que de se relever au GPS.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FrigoProApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrigoPro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FrigoPro"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Par où l'application d'appareil photo écrit dans notre dossier privé :
            elle reçoit un URI `content://` valable le temps de la prise de vue,
            et non un chemin de fichier, qu'Android refuse de transmettre.
            `grantUriPermissions` sans `exported` : personne ne peut venir lire
            nos photos, seul le destinataire d'une intention y a accès.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/chemins_photos" />
        </provider>

    </application>

</manifest>
